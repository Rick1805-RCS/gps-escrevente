            }
        }

        function updateItemQuestao(id, field, value) {
            const item = editalState.find(i => i.id === id);
            if (item) {
                const val = parseInt(value) || 0;
                if (field === 'acertos' && val > item.questoes) {
                    showToast("Acertos não podem ser superiores às questões!", "error");
                    renderEdital();
                    return;
                }
                item[field] = val;
                saveData();
                renderEdital();
            }
        }

