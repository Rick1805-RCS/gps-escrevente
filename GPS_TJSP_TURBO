<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GPS Escrevente - TJSP | Modo Caverna</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        caverna: {
                            darkest: '#090d16',
                            dark: '#0f172a',
                            card: '#1e293b',
                            border: '#334155',
                            accent: '#f59e0b',
                            accentHover: '#d97706',
                            success: '#10b981',
                            info: '#3b82f6',
                            warning: '#f97316',
                            danger: '#ef4444'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }
    </style>
</head>
<body class="bg-caverna-darkest text-slate-100 min-h-screen flex flex-col selection:bg-amber-500 selection:text-black">

    <!-- Top Header -->
    <header class="bg-caverna-dark border-b border-caverna-border sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-md shadow-amber-500/20">
                    <i class="fa-solid fa-compass text-black text-lg font-bold"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg sm:text-xl tracking-tight text-white flex items-center gap-2">
                        GPS Escrevente <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30">TJSP 2026</span>
                    </h1>
                    <p class="text-xs text-slate-400 hidden sm:block">Controle Total • Ciclos, Caderno de Erros & Flashcards • Modo Caverna</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <button onclick="resetData()" class="text-xs bg-slate-800 hover:bg-red-950/40 text-slate-300 hover:text-red-400 border border-slate-700 hover:border-red-800/60 px-3 py-2 rounded-lg transition-all flex items-center gap-1.5" title="Redefinir dados">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span class="hidden md:inline">Resetar</span>
                </button>
                <div class="h-6 w-px bg-caverna-border"></div>
                <div class="text-right hidden sm:block">
                    <div class="text-xs text-slate-400">Edital Concluído</div>
                    <div id="header-progress-pct" class="text-sm font-bold text-amber-400">0%</div>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="bg-caverna-dark/80 backdrop-blur-md border-b border-caverna-border sticky top-16 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto space-x-2 py-2.5 no-scrollbar">
            <button onclick="switchTab('dashboard')" id="btn-tab-dashboard" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 bg-amber-500 text-black shadow-lg shadow-amber-500/20 whitespace-nowrap">
                <i class="fa-solid fa-chart-pie"></i> Painel Geral
            </button>
            <button onclick="switchTab('edital')" id="btn-tab-edital" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800 whitespace-nowrap">
                <i class="fa-solid fa-list-check"></i> Edital Verticalizado (<span id="total-badge">112</span>)
            </button>
            <button onclick="switchTab('ciclo')" id="btn-tab-ciclo" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800 whitespace-nowrap">
                <i class="fa-solid fa-arrows-spin"></i> Ciclo de Estudos
            </button>
            <button onclick="switchTab('erros')" id="btn-tab-erros" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800 whitespace-nowrap">
                <i class="fa-solid fa-triangle-exclamation"></i> Caderno de Erros & Flashcards
            </button>
            <button onclick="switchTab('redacao')" id="btn-tab-redacao" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800 whitespace-nowrap">
                <i class="fa-solid fa-pen-nib"></i> Módulo Redação
            </button>
            <button onclick="switchTab('notas')" id="btn-tab-notas" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800 whitespace-nowrap">
                <i class="fa-solid fa-book-bookmark"></i> Notas e Fontes
            </button>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full">

        <!-- ================= TAB 1: PAINEL GERAL ================= -->
        <div id="tab-dashboard" class="tab-content space-y-6">
            <div class="bg-gradient-to-r from-slate-900 via-caverna-card to-slate-900 border border-caverna-border rounded-2xl p-6 sm:p-8 relative overflow-hidden shadow-xl">
                <div class="absolute right-0 top-0 translate-x-6 -translate-y-6 w-64 h-64 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
                <div class="relative z-10 max-w-2xl">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 inline-block mb-3">
                        <i class="fa-solid fa-fire mr-1"></i> Modo Caverna • TJSP
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Painel de Controle do Escrevente</h2>
                    <p class="text-slate-300 mt-2 text-sm sm:text-base">
                        Acompanhe seu progresso em tempo real nos 112 tópicos do edital, execute o ciclo semanal (A-G), alimente seu Caderno de Erros e gere Flashcards automáticos.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-caverna-card border border-caverna-border rounded-xl p-5 shadow-md">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-bold tracking-wider">Total Tópicos</span>
                        <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                    </div>
                    <div id="kpi-total" class="text-2xl sm:text-3xl font-extrabold text-white">112</div>
                    <div class="text-xs text-slate-400 mt-1">Edital completo</div>
                </div>

                <div class="bg-caverna-card border border-caverna-border rounded-xl p-5 shadow-md">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-bold tracking-wider">Concluídos</span>
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                    <div id="kpi-concluidos" class="text-2xl sm:text-3xl font-extrabold text-emerald-400">0</div>
                    <div class="text-xs text-slate-400 mt-1"><span id="kpi-pct-concluidos">0</span>% concluído</div>
                </div>

                <div class="bg-caverna-card border border-caverna-border rounded-xl p-5 shadow-md">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-bold tracking-wider">Erros Registrados</span>
                        <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                    </div>
                    <div id="kpi-erros" class="text-2xl sm:text-3xl font-extrabold text-amber-400">0</div>
                    <div class="text-xs text-slate-400 mt-1">Caderno de Erros</div>
                </div>

                <div class="bg-caverna-card border border-caverna-border rounded-xl p-5 shadow-md">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-bold tracking-wider">Flashcards Ativos</span>
                        <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center">
                            <i class="fa-solid fa-clone"></i>
                        </div>
                    </div>
                    <div id="kpi-flashcards" class="text-2xl sm:text-3xl font-extrabold text-purple-400">0</div>
                    <div class="text-xs text-slate-400 mt-1">Revisão interativa</div>
                </div>
            </div>

            <!-- Secondary Metrics -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-caverna-card border border-caverna-border rounded-xl p-5 shadow-md flex items-center justify-between">
                    <div>
                        <div class="text-xs text-slate-400 uppercase font-bold tracking-wider">Questões Resolvidas</div>
                        <div id="kpi-questoes-total" class="text-2xl font-bold text-white mt-1">0</div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                </div>

                <div class="bg-caverna-card border border-caverna-border rounded-xl p-5 shadow-md flex items-center justify-between">
                    <div>
                        <div class="text-xs text-slate-400 uppercase font-bold tracking-wider">Acertos Totais</div>
                        <div id="kpi-acertos-total" class="text-2xl font-bold text-emerald-400 mt-1">0</div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>
                </div>

                <div class="bg-caverna-card border border-caverna-border rounded-xl p-5 shadow-md flex items-center justify-between">
                    <div>
                        <div class="text-xs text-slate-400 uppercase font-bold tracking-wider">Aproveitamento Médio</div>
                        <div id="kpi-aproveitamento-geral" class="text-2xl font-bold text-amber-400 mt-1">0%</div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
            </div>

            <div class="bg-caverna-card border border-caverna-border rounded-xl p-6 shadow-md">
                <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-sm text-slate-200">Evolução Geral do Edital</span>
                    <span id="progress-bar-text" class="text-sm font-bold text-amber-400">0% Concluído</span>
                </div>
                <div class="w-full bg-slate-800 rounded-full h-3 overflow-hidden border border-slate-700">
                    <div id="progress-bar-fill" class="bg-gradient-to-r from-amber-500 to-orange-500 h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
            </div>
        </div>

        <!-- ================= TAB 2: EDITAL VERTICALIZADO ================= -->
        <div id="tab-edital" class="tab-content hidden space-y-6">
            <div class="bg-caverna-card border border-caverna-border rounded-xl p-4 shadow-md flex flex-col md:flex-row gap-4 items-center justify-between">
                <div class="w-full md:w-1/3 relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="search-input" oninput="filterEdital()" placeholder="Buscar tópico..." class="w-full bg-caverna-dark border border-caverna-border rounded-lg pl-10 pr-4 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-500">
                </div>

                <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
                    <select id="filter-bloco" onchange="filterEdital()" class="bg-caverna-dark border border-caverna-border rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-500">
                        <option value="">Todos os Blocos</option>
                        <option value="Bloco I">Bloco I</option>
                        <option value="Bloco II">Bloco II</option>
                        <option value="Bloco III">Bloco III</option>
                    </select>

                    <select id="filter-disciplina" onchange="filterEdital()" class="bg-caverna-dark border border-caverna-border rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-500">
                        <option value="">Todas as Disciplinas</option>
                    </select>

                    <select id="filter-status" onchange="filterEdital()" class="bg-caverna-dark border border-caverna-border rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-500">
                        <option value="">Todos os Status</option>
                        <option value="Pendente">Pendente</option>
                        <option value="Em andamento">Em andamento</option>
                        <option value="Concluído">Concluído</option>
                    </select>
                </div>
            </div>

            <div class="bg-caverna-card border border-caverna-border rounded-xl shadow-md overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-900/80 border-b border-caverna-border text-xs uppercase text-slate-400 font-semibold tracking-wider">
                                <th class="py-3 px-4 w-12 text-center">#</th>
                                <th class="py-3 px-4 w-28">Bloco</th>
                                <th class="py-3 px-4 w-44">Disciplina</th>
                                <th class="py-3 px-4">Tópico do Edital</th>
                                <th class="py-3 px-4 w-36 text-center">Status</th>
                                <th class="py-3 px-4 w-24 text-center">Q. Feitas</th>
                                <th class="py-3 px-4 w-24 text-center">Acertos</th>
                                <th class="py-3 px-4 w-24 text-center">% Acerto</th>
                            </tr>
                        </thead>
                        <tbody id="edital-tbody" class="divide-y divide-caverna-border text-sm text-slate-300">
                            <!-- Injected dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= TAB 3: CICLO DE ESTUDOS ================= -->
        <div id="tab-ciclo" class="tab-content hidden space-y-6">
            <div class="bg-caverna-card border border-caverna-border rounded-xl p-6 shadow-md">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <div>
                        <h3 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-arrows-spin text-amber-400"></i> Ciclo de Estudos — Padrão TJSP (A a G)
                        </h3>
                        <p class="text-sm text-slate-400 mt-1">Ciclo oficial com Blocos A, B, C, metas, execução e acompanhamento persistente.</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-900/80 border-b border-caverna-border text-xs uppercase text-slate-400 font-semibold tracking-wider">
                                <th class="py-3 px-4 w-20 text-center">Ciclo</th>
                                <th class="py-3 px-4">Bloco principal A</th>
                                <th class="py-3 px-4">Bloco complementar B</th>
                                <th class="py-3 px-4">Bloco complementar C</th>
                                <th class="py-3 px-4">Meta de execução</th>
                                <th class="py-3 px-4">Como executar</th>
                                <th class="py-3 px-4 w-28 text-center">Concluído?</th>
                                <th class="py-3 px-4 w-48">Observações</th>
                            </tr>
                        </thead>
                        <tbody id="ciclo-tbody" class="divide-y divide-caverna-border text-sm text-slate-300">
                            <!-- Injected dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= TAB 4: CADERNO DE ERROS & FLASHCARDS ================= -->
        <div id="tab-erros" class="tab-content hidden space-y-6">
            <div class="bg-caverna-card border border-caverna-border rounded-xl p-6 shadow-md space-y-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h3 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation text-amber-400"></i> Caderno de Erros & Flashcards Interativos
                        </h3>
                        <p class="text-sm text-slate-400 mt-1">Registre seus erros nos 4 blocos exatos, cole prints e clique em "Criar Flashcards" para memorização ativa.</p>
                    </div>
                    <button onclick="switchErrosSubtab('form')" class="bg-amber-500 hover:bg-amber-600 text-black font-semibold px-4 py-2 rounded-lg text-sm transition-all flex items-center gap-2 shadow-lg shadow-amber-500/25">
                        <i class="fa-solid fa-plus"></i> Novo Erro / Card
                    </button>
                </div>

                <!-- Subtab Selector -->
                <div class="flex space-x-2 border-b border-caverna-border pb-3">
                    <button onclick="switchErrosSubtab('list')" id="subbtn-list" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-amber-500 text-black transition-all">
                        <i class="fa-solid fa-list mr-1.5"></i> Meus Erros Registrados
                    </button>
                    <button onclick="switchErrosSubtab('form')" id="subbtn-form" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white transition-all">
                        <i class="fa-solid fa-pen-to-square mr-1.5"></i> Cadastrar Novo Erro
                    </button>
                    <button onclick="switchErrosSubtab('flashcards')" id="subbtn-flashcards" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white transition-all">
                        <i class="fa-solid fa-clone mr-1.5"></i> Flashcards Interativos (<span id="fc-count">0</span>)
                    </button>
                </div>

                <!-- SUBTAB A: LISTAGEM DE ERROS -->
                <div id="erros-sub-list" class="space-y-4">
                    <div id="erros-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Injected dynamically -->
                    </div>
                </div>

                <!-- SUBTAB B: FORMULÁRIO DE CADASTRO DE ERRO (4 BLOCOS) -->
                <div id="erros-sub-form" class="space-y-6 hidden">
                    <div class="bg-caverna-dark border border-caverna-border rounded-xl p-6 space-y-6">
                        <div class="flex items-center justify-between">
                            <h4 class="font-bold text-white text-base">Novo Registro no Caderno de Erros</h4>
                            <select id="erro-disciplina" class="bg-caverna-card border border-caverna-border rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500">
                                <option value="Língua Portuguesa">Língua Portuguesa</option>
                                <option value="Normas da Corregedoria">Normas da Corregedoria</option>
                                <option value="Direito Administrativo">Direito Administrativo</option>
                                <option value="Direito Constitucional">Direito Constitucional</option>
                                <option value="Direito Penal">Direito Penal</option>
                                <option value="Direito Processual Penal">Direito Processual Penal</option>
                                <option value="Direito Processual Civil">Direito Processual Civil</option>
                                <option value="Matemática">Matemática</option>
                                <option value="Raciocínio Lógico">Raciocínio Lógico</option>
                                <option value="Noções de Informática">Noções de Informática</option>
                                <option value="Atualidades">Atualidades</option>
                            </select>
                        </div>

                        <!-- 4 Blocos Form -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Bloco 1 -->
                            <div class="bg-caverna-card border border-caverna-border rounded-xl p-4 space-y-2 flex flex-col">
                                <label class="text-xs uppercase font-bold text-slate-300 flex items-center justify-between">
                                    <span>O enunciado</span>
                                    <span class="text-[10px] text-slate-500 font-normal">Aceita texto ou colar print (Ctrl+V)</span>
                                </label>
                                <div id="box-enunciado" contenteditable="true" onpaste="handleImagePaste(event, 'img-enunciado')" class="w-full flex-grow min-h-[120px] bg-caverna-dark border border-caverna-border rounded-lg p-3 text-xs text-slate-100 focus:outline-none focus:border-amber-500 overflow-y-auto"></div>
                                <input type="hidden" id="img-enunciado" value="">
                                <div id="preview-enunciado" class="mt-2 hidden"></div>
                            </div>

                            <!-- Bloco 2 -->
                            <div class="bg-caverna-card border border-caverna-border rounded-xl p-4 space-y-2 flex flex-col">
                                <label class="text-xs uppercase font-bold text-slate-300 flex items-center justify-between">
                                    <span>O que você marcou</span>
                                    <span class="text-[10px] text-slate-500 font-normal">Erro cometido</span>
                                </label>
                                <div id="box-marcado" contenteditable="true" onpaste="handleImagePaste(event, 'img-marcado')" class="w-full flex-grow min-h-[120px] bg-caverna-dark border border-caverna-border rounded-lg p-3 text-xs text-slate-100 focus:outline-none focus:border-amber-500 overflow-y-auto"></div>
                                <input type="hidden" id="img-marcado" value="">
                                <div id="preview-marcado" class="mt-2 hidden"></div>
                            </div>

                            <!-- Bloco 3 -->
                            <div class="bg-caverna-card border border-caverna-border rounded-xl p-4 space-y-2 flex flex-col">
                                <label class="text-xs uppercase font-bold text-emerald-400 flex items-center justify-between">
                                    <span>A resposta certa</span>
                                    <span class="text-[10px] text-slate-500 font-normal">Gabarito correto</span>
                                </label>
                                <div id="box-certa" contenteditable="true" onpaste="handleImagePaste(event, 'img-certa')" class="w-full flex-grow min-h-[120px] bg-caverna-dark border border-emerald-500/30 rounded-lg p-3 text-xs text-slate-100 focus:outline-none focus:border-emerald-500 overflow-y-auto"></div>
