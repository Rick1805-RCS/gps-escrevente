            const disciplina = document.getElementById('erro-disciplina').value;
            const enunciado = document.getElementById('box-enunciado').innerHTML.trim();
            const marcado = document.getElementById('box-marcado').innerHTML.trim();
            const certa = document.getElementById('box-certa').innerHTML.trim();
