            errosState.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-caverna-dark border border-caverna-border rounded-xl p-5 space-y-4 shadow-md flex flex-col justify-between";
                card.innerHTML = `
                    <div class="flex items-center justify-between border-b border-caverna-border pb-3">
                        <span class="px-2.5 py-0.5 rounded-md bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">${item.disciplina}</span>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-slate-500">${item.data}</span>
                            <button onclick="gerarFlashcardAvulso(${item.id})" class="text-xs bg-slate-800 hover:bg-purple-950/40 text-purple-400 border border-purple-800/50 px-2.5 py-1 rounded-lg transition-all" title="Criar Flashcard">
                                <i class="fa-solid fa-clone mr-1"></i> Criar Flashcard
                            </button>
                            <button onclick="deletarErro(${item.id})" class="text-slate-500 hover:text-red-400 p-1" title="Excluir">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                        <div class="bg-caverna-card p-3 rounded-lg border border-caverna-border space-y-1">
                            <div class="font-bold text-slate-400 uppercase text-[10px]">O enunciado</div>
                            <div class="text-slate-200">${item.enunciado || '(Sem texto)'}</div>
                            ${item.imgEnunciado ? `<img src="${item.imgEnunciado}" class="max-h-24 rounded mt-1">` : ''}
                        </div>

                        <div class="bg-caverna-card p-3 rounded-lg border border-red-950/40 space-y-1">
                            <div class="font-bold text-red-400 uppercase text-[10px]">O que você marcou</div>
                            <div class="text-slate-200">${item.marcado || '(Não informado)'}</div>
                            ${item.imgMarcado ? `<img src="${item.imgMarcado}" class="max-h-24 rounded mt-1">` : ''}
                        </div>

                        <div class="bg-caverna-card p-3 rounded-lg border border-emerald-950/40 space-y-1">
                            <div class="font-bold text-emerald-400 uppercase text-[10px]">A resposta certa</div>
                            <div class="text-slate-200">${item.certa || '(Não informado)'}</div>
                            ${item.imgCerta ? `<img src="${item.imgCerta}" class="max-h-24 rounded mt-1">` : ''}
                        </div>

                        <div class="bg-caverna-card p-3 rounded-lg border border-amber-950/40 space-y-1">
                            <div class="font-bold text-amber-400 uppercase text-[10px]">A explicação com as suas palavras</div>
                            <div class="text-slate-200">${item.explicacao || '(Não informado)'}</div>
                            ${item.imgExplicacao ? `<img src="${item.imgExplicacao}" class="max-h-24 rounded mt-1">` : ''}
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
            document.getElementById('fc-count').textContent = flashcardsState.length;
        }

        function deletarErro(id) {
            if (confirm("Deseja excluir este erro?")) {
                errosState = errosState.filter(e => e.id !== id);
                saveData();
                renderErros();
                showToast("Erro excluído.", "info");
            }
        }

        function gerarFlashcardAvulso(erroId) {
            const erro = errosState.find(e => e.id === erroId);
            if (erro) {
                const novoFc = {
                    id: Date.now(),
                    pergunta: `[${erro.disciplina}] ${erro.enunciado.replace(/<[^>]*>?/gm, '').substring(0, 90)}...`,
                    resposta: `${erro.certa}\n\nExplicação: ${erro.explicacao}`
                };
                flashcardsState.unshift(novoFc);
                saveData();
                renderFlashcards();
                showToast("Flashcard gerado com sucesso!", "success");
            }
        }

        function renderFlashcards() {
            const container = document.getElementById('flashcards-container');
            container.innerHTML = '';

            if (flashcardsState.length === 0) {
                container.innerHTML = `<div class="col-span-3 py-12 text-center text-slate-500">Nenhum flashcard gerado ainda. Cadastre erros para gerar cartas de memorização.</div>`;
                document.getElementById('fc-count').textContent = 0;
                return;
            }

            flashcardsState.forEach((fc, index) => {
                const cardWrapper = document.createElement('div');
                cardWrapper.className = "h-64 perspective-1000 cursor-pointer";
                cardWrapper.innerHTML = `
                    <div id="fc-inner-${fc.id}" class="w-full h-full relative transform-style-3d transition-transform duration-500 shadow-xl rounded-xl" onclick="flipCard(${fc.id})">
                        <!-- Front -->
                        <div class="absolute inset-0 w-full h-full bg-caverna-dark border border-caverna-border rounded-xl p-5 flex flex-col justify-between backface-hidden">
                            <div class="flex justify-between items-center text-xs text-amber-400 font-bold">
                                <span>Flashcard #${index + 1}</span>
                                <span class="text-[10px] text-slate-500 uppercase">Clique para virar</span>
                            </div>
                            <div class="text-sm font-medium text-slate-200 overflow-y-auto my-auto">
                                ${fc.pergunta}
                            </div>
                            <div class="text-center text-xs text-slate-500">
                                <i class="fa-solid fa-rotate mr-1"></i> Virar carta
                            </div>
                        </div>
                        <!-- Back -->
                        <div class="absolute inset-0 w-full h-full bg-slate-900 border border-emerald-500/40 rounded-xl p-5 flex flex-col justify-between backface-hidden rotate-y-180">
                            <div class="flex justify-between items-center text-xs text-emerald-400 font-bold">
                                <span>Resposta / Gabarito</span>
                                <button onclick="deletarFlashcard(event, ${fc.id})" class="text-slate-500 hover:text-red-400 text-xs" title="Excluir Flashcard">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                            <div class="text-xs text-slate-300 overflow-y-auto my-auto leading-relaxed whitespace-pre-line">
                                ${fc.resposta}
                            </div>
                            <div class="text-center text-[10px] text-slate-500">
                                Clique novamente para desvirar
                            </div>
                        </div>
                    </div>
                `;
                container.appendChild(cardWrapper);
            });
            document.getElementById('fc-count').textContent = flashcardsState.length;
        }

        function flipCard(id) {
            const inner = document.getElementById(`fc-inner-${id}`);
            if (inner) {
                inner.classList.toggle('rotate-y-180');
            }
        }

        function deletarFlashcard(event, id) {
            event.stopPropagation();
            if (confirm("Deseja excluir este flashcard?")) {
                flashcardsState = flashcardsState.filter(f => f.id !== id);
                saveData();
                renderFlashcards();
                showToast("Flashcard excluído.", "info");
            }
        }

        function updateLineCounts() {
            const intro = document.getElementById('live-intro').value.trim();
            const dev1 = document.getElementById('live-dev1').value.trim();
            const dev2 = document.getElementById('live-dev2').value.trim();
            const concl = document.getElementById('live-concl').value.trim();

            const countWords = (text) => text === "" ? 0 : text.split(/\s+/).length;
            const approxLines = (text) => {
                const words = countWords(text);
                return Math.max(1, Math.ceil(words / 10));
            };

            const lIntro = approxLines(intro);
            const lDev1 = approxLines(dev1);
            const lDev2 = approxLines(dev2);
            const lConcl = approxLines(concl);

            document.getElementById('count-intro').textContent = `${lIntro} linhas`;
            document.getElementById('count-dev1').textContent = `${lDev1} linhas`;
            document.getElementById('count-dev2').textContent = `${lDev2} linhas`;
            document.getElementById('count-concl').textContent = `${lConcl} linhas`;

            const total = lIntro + lDev1 + lDev2 + lConcl;
            document.getElementById('total-lines').textContent = total;
        }

        function clearRedacaoForm() {
            document.getElementById('live-tema').value = "";
            document.getElementById('live-nota').value = "";
            document.getElementById('live-intro').value = "";
            document.getElementById('live-dev1').value = "";
            document.getElementById('live-dev2').value = "";
            document.getElementById('live-concl').value = "";
            updateLineCounts();
            showToast("Formulário limpo.", "info");
        }

        function simularEnvioRedacao() {
            const tema = document.getElementById('live-tema').value.trim();
            const nota = parseFloat(document.getElementById('live-nota').value) || 0;
            const intro = document.getElementById('live-intro').value.trim();
            const dev1 = document.getElementById('live-dev1').value.trim();
            const dev2 = document.getElementById('live-dev2').value.trim();
            const concl = document.getElementById('live-concl').value.trim();

            if (!tema) {
                showToast("Por favor, informe o tema da redação.", "error");
                return;
            }

            const novaRedacao = {
                id: Date.now(),
                data: new Date().toISOString().split('T')[0],
                tema,
                nota,
                intro,
                dev1,
                dev2,
                concl
            };

            redacaoState.unshift(novaRedacao);
            saveData();
            renderRedacao();
            showToast("Redação salva e simulada com sucesso!", "success");
        }

        function renderRedacao() {
            const tbody = document.getElementById('redacao-tbody');
            tbody.innerHTML = '';

            if (redacaoState.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-slate-500">Nenhum treino de redação salvo ainda.</td></tr>`;
                return;
            }

            redacaoState.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/50 transition-all border-b border-caverna-border/50";
                tr.innerHTML = `
                    <td class="py-3 px-4 text-xs text-slate-400 font-medium">${item.data}</td>
                    <td class="py-3 px-4 font-semibold text-slate-200 text-sm">${item.tema}</td>
                    <td class="py-3 px-4 text-center font-bold text-amber-400 text-sm">${item.nota}</td>
                    <td class="py-3 px-4 text-center">
                        <button onclick="deleteRedacao(${item.id})" class="text-slate-500 hover:text-red-400 transition-all p-1" title="Excluir">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function deleteRedacao(id) {
            if (confirm("Deseja excluir este registro de redação?")) {
                redacaoState = redacaoState.filter(r => r.id !== id);
                saveData();
                renderRedacao();
                showToast("Registro excluído.", "info");
            }
        }

        function renderDashboard() {
            const total = editalState.length;
            const concluidos = editalState.filter(i => i.status === 'Concluído').length;
            const pctConcluidos = Math.round((concluidos / total) * 100);

            let totalQ = 0;
            let totalA = 0;
            editalState.forEach(i => {
                totalQ += i.questoes;
                totalA += i.acertos;
            });
            const aproveitamentoGeral = totalQ > 0 ? Math.round((totalA / totalQ) * 100) : 0;

            document.getElementById('kpi-total').textContent = total;
            document.getElementById('kpi-concluidos').textContent = concluidos;
            document.getElementById('kpi-pct-concluidos').textContent = pctConcluidos;
            document.getElementById('kpi-erros').textContent = errosState.length;
            document.getElementById('kpi-flashcards').textContent = flashcardsState.length;

            document.getElementById('kpi-questoes-total').textContent = totalQ;
            document.getElementById('kpi-acertos-total').textContent = totalA;
            document.getElementById('kpi-aproveitamento-geral').textContent = aproveitamentoGeral + '%';

            document.getElementById('header-progress-pct').textContent = pctConcluidos + '%';
            document.getElementById('progress-bar-text').textContent = pctConcluidos + '% Concluído (' + concluidos + '/' + total + ')';
            document.getElementById('progress-bar-fill').style.width = pctConcluidos + '%';
            document.getElementById('total-badge').textContent = total;
        }

        function showToast(msg, type = "success") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.textContent = msg;
            if (type === "success") {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
            } else if (type === "error") {
                toastIcon.className = "fa-solid fa-circle-exclamation text-red-400 text-lg";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-blue-400 text-lg";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
