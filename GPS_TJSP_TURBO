        // Image Paste Handler for Caderno de Erros
        function handleImagePaste(event, targetInputId) {
            const items = (event.clipboardData || event.originalEvent.clipboardData).items;
            for (let index in items) {
                const item = items[index];
                if (item.kind === 'file') {
                    const blob = item.getAsFile();
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const base64Img = e.target.result;
                        document.getElementById(targetInputId).value = base64Img;
                        const containerId = 'preview-' + targetInputId.replace('img-', '');
                        const previewEl = document.getElementById(containerId);
                        previewEl.innerHTML = `<img src="${base64Img}" class="max-h-32 rounded border border-caverna-border mt-1">`;
                        previewEl.classList.remove('hidden');
                        showToast("Print/Imagem colado com sucesso!", "success");
                    };
                    reader.readAsDataURL(blob);
                    event.preventDefault();
                }
            }
        }

