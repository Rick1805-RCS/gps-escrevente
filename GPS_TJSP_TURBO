            const imgEnunciado = document.getElementById('img-enunciado').value;
            const imgMarcado = document.getElementById('img-marcado').value;
            const imgCerta = document.getElementById('img-certa').value;
            const imgExplicacao = document.getElementById('img-explicacao').value;

            if (!enunciado && !imgEnunciado) {
                showToast("Preencha ao menos o enunciado do erro.", "error");
                return;
            }

            const novoErro = {
                id: Date.now(),
                disciplina,
                enunciado,
                marcado,
                certa,
                explicacao,
                imgEnunciado,
                imgMarcado,
                imgCerta,
                imgExplicacao,
                data: new Date().toISOString().split('T')[0]
            };

            errosState.unshift(novoErro);

            // Automatically create Flashcard
            const novoFc = {
                id: Date.now() + 1,
                pergunta: `[${disciplina}] O que diz a resposta correta para: "${enunciado.replace(/<[^>]*>?/gm, '').substring(0, 80)}..."?`,
                resposta: `${certa}\n\nExplicação: ${explicacao}`
            };
            flashcardsState.unshift(novoFc);

            saveData();
            clearErroForm();
            switchErrosSubtab('list');
            showToast("Erro salvo e Flashcard gerado com sucesso!", "success");
