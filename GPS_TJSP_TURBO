        function filterEdital() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const bloco = document.getElementById('filter-bloco').value;
            const disciplina = document.getElementById('filter-disciplina').value;
            const status = document.getElementById('filter-status').value;

            const filtered = editalState.filter(item => {
                const matchQuery = item.topico.toLowerCase().includes(query) || item.disciplina.toLowerCase().includes(query);
                const matchBloco = bloco ? item.bloco === bloco : true;
                const matchDisc = disciplina ? item.disciplina === disciplina : true;
                const matchStatus = status ? item.status === status : true;
                return matchQuery && matchBloco && matchDisc && matchStatus;
            });
            renderEdital(filtered);
        }

